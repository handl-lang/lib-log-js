--- log-js -- the JavaScript backend for the `log` contract.
---
--- Leveled records to the JS console over the host-injected
--- `js.call` marshaller: `console.debug`/`info`/`warn`/`error` — the
--- browser/worker-native sink, level-coloured by the devtools and
--- structured attrs passed as a real JS object (devtools inspection,
--- no string round-trip). `fatal` maps to `console.error` (there is
--- no `console.fatal`); `trace` maps to `console.debug` (`console.trace`
--- prints a stack, which is not what a leveled record wants).
---
--- Call shape: `call("console", <method>, [line] or [line, attrs],
--- ["js_string"], ["js_string", "js_object"], "js_void", false)`.
--- `line` is the contract's canonical `format` rendering with attrs
--- suppressed (`LEVEL ISO-8601-UTC message`); the merged attrs record
--- rides as the second argument so console shows it as an object.
--- When the merged attrs are empty the second argument is omitted —
--- `console.info("msg", {})` would just print a noise `{}`.
---
--- Timestamp: `Date.now()` -> epoch ms -> the same proleptic
--- Gregorian civil-from-days algorithm `log-c` uses, formatted
--- `YYYY-MM-DDTHH:MM:SS.mmmZ` (always UTC — `toISOString` would need a
--- `Date` receiver round-trip through `js.construct`/`js.invoke` for
--- no gain).
---
--- Marshalling: the attrs record crosses as `js_object` — the ffi's
--- catch-all for record/union values (the `lib-json-js`/
--- `lib-fetch-js` choice). Under the compile-js default shim a handl
--- record already lowers to a JS object, so `console.*` sees exactly
--- the structured data.
---
--- `js`, `str`, `obj`, `char`, `type` resolve through imports / the
--- host module chain. `error` is imported as `raise` because this
--- module EXPORTS an arrow named `error` (the fatal-level
--- convenience), which would otherwise shadow the host `error` module
--- inside the file (the log-c lesson).

from "js" import { call }
from "str" import * as strm
from "obj" import * as obj
from "char" import * as charm
from "error" import { raise }

-- ---------------------------------------------------------------------------
-- Levels (contract: "trace" < "debug" < "info" < "warn" < "error" < "fatal")
-- ---------------------------------------------------------------------------

--- rank: 0..5 for the six level names, -1 for anything else.
rank := (lvl) ~> if lvl == "trace" {
  0
} else if lvl == "debug" {
  1
} else if lvl == "info" {
  2
} else if lvl == "warn" {
  3
} else if lvl == "error" {
  4
} else if lvl == "fatal" {
  5
} else {
  -1
}

--- Reject an unrecognised level — `log: unknown level '<name>'`.
need_level := (lvl) ~> if rank(lvl) < 0 {
  raise("log: unknown level '" + type.to_string(lvl) + "'")
} else {
  null
}

-- ---------------------------------------------------------------------------
-- Pure logger algebra (contract: make / with_level / child / should_log)
-- ---------------------------------------------------------------------------

--- attrs_or_empty: null -> {}, record -> itself.
attrs_or_empty := (a) ~> if a == null { {} } else { a }

--- merge(base, extra): `extra`'s entries set over `base` — the
--- right-hand (child/event) value wins on a key collision.
merge := (base, extra) ~> if extra == null {
  base
} else {
  while { es: obj.entries(extra), acc: base } {
    (es, acc) ~> match es {
      []: { out: acc },
      [h, ...t]: { state: { es: t, acc: obj.set(acc, h[0], h[1]) } }
    }
  }
}

--- make(min, attrs): `{ min_level, attrs }` — attrs normalised to {}.
make := (min, attrs) ~> do {
  need_level(min)
  { min_level: min, attrs: attrs_or_empty(attrs) }
}

--- with_level(l, lvl): l with min_level replaced (extra fields kept).
with_level := (l, lvl) ~> do {
  need_level(lvl)
  obj.set(l, "min_level", lvl)
}

--- child(l, attrs): l with `attrs` merged into its carried attrs.
child := (l, attrs) ~> obj.set(l, "attrs", merge(l.attrs, attrs))

--- should_log(l, lvl): rank(lvl) >= rank(l.min_level); unknown -> false.
should_log := (l, lvl) ~> rank(lvl) >= rank(l.min_level)

export level_rank := rank
export make := make
export with_level := with_level
export child := child
export should_log := should_log

-- ---------------------------------------------------------------------------
-- Canonical rendering (contract: format) — same k=v text as log-c.
-- ---------------------------------------------------------------------------

--- Chars that never force quoting: ASCII alnum plus _./:@+-.
SAFE := "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_./:@+-"

--- needs_quote(s): empty or any char outside SAFE.
needs_quote := (s) ~> do {
  if strm.length(s) == 0 {
    true
  } else {
    while { cs: charm.chars(s), bad: false } {
      (cs, bad) ~> match cs {
        []: { out: bad },
        [c, ...t]: { state: { cs: t, bad: bad || strm.find(SAFE, c) < 0 } }
      }
    }
  }
}

--- Escape `"` and `\` inside a quoted string.
esc := (s) ~> while { cs: charm.chars(s), acc: "" } {
  (cs, acc) ~> match cs {
    []: { out: acc },
    ["\\", ...t]: { state: { cs: t, acc: acc + "\\\\" } },
    ["\"", ...t]: { state: { cs: t, acc: acc + "\\\"" } },
    [c, ...t]: { state: { cs: t, acc: acc + c } }
  }
}

--- Render one attr value: strings quoted iff needed, else type.to_string.
show := (v) ~> if type.of(v) == "string" {
  if needs_quote(v) { "\"" + esc(v) + "\"" } else { v }
} else {
  type.to_string(v)
}

--- format(ts, lvl, msg, attrs): `"LEVEL ts msg k=v ..."` — identical to
--- the log-c rendering so `format` is backend-portable.
format := (ts, lvl, msg, attrs) ~> do {
  need_level(lvl)
  head := strm.upper(lvl) + " " + ts + " " + msg
  a := attrs_or_empty(attrs)
  while { es: obj.entries(a), acc: head } {
    (es, acc) ~> match es {
      []: { out: acc },
      [h, ...t]: { state: { es: t, acc: acc + " " + h[0] + "=" + show(h[1]) } }
    }
  }
}

export format := format

-- ---------------------------------------------------------------------------
-- Timestamp: Date.now() -> ISO-8601 UTC, ms precision (log-c's algorithm).
-- ---------------------------------------------------------------------------

--- epoch milliseconds from the JS clock.
now_ms := () ~> call("Date", "now", [], [], "js_number", false)

pad2 := (n) ~> strm.pad_left(type.to_string(n), 2, "0")
pad4 := (n) ~> strm.pad_left(type.to_string(n), 4, "0")

--- Proleptic Gregorian civil date from days since 1970-01-01
--- (Howard Hinnant's civil_from_days — the lib-datetime algorithm).
civil := (days) ~> do {
  z := days + 719468
  era := math.floor_div(z, 146097)
  doe := z - era * 146097
  yoe := math.floor_div(doe - math.floor_div(doe, 1460)
    + math.floor_div(doe, 36524) - math.floor_div(doe, 146096), 365)
  y := yoe + era * 400
  doy := doe - (365 * yoe + math.floor_div(yoe, 4) - math.floor_div(yoe, 100))
  mp := math.floor_div(5 * doy + 2, 153)
  d := doy - math.floor_div(153 * mp + 2, 5) + 1
  m := mp + (if mp < 10 { 3 } else { 0 - 9 })
  { y: y + (if m <= 2 { 1 } else { 0 }), m: m, d: d }
}

--- ISO-8601 UTC timestamp with millisecond precision:
--- `YYYY-MM-DDTHH:MM:SS.mmmZ`.
iso_now := () ~> do {
  ms := now_ms()
  days := math.floor_div(ms, 86400000)
  sod := ms - days * 86400000
  c := civil(days)
  hh := math.floor_div(sod, 3600000)
  mi := math.floor_div(sod - hh * 3600000, 60000)
  ss := math.floor_div(sod - hh * 3600000 - mi * 60000, 1000)
  mmm := sod - hh * 3600000 - mi * 60000 - ss * 1000
  pad4(c.y) + "-" + pad2(c.m) + "-" + pad2(c.d)
    + "T" + pad2(hh) + ":" + pad2(mi) + ":" + pad2(ss)
    + "." + strm.pad_left(type.to_string(mmm), 3, "0") + "Z"
}

-- ---------------------------------------------------------------------------
-- Sink: console.<method>(line[, attrs]) via js.call.
-- ---------------------------------------------------------------------------

--- console method for a level: trace->debug, fatal->error (see header).
console_method := (lvl) ~> if lvl == "trace" || lvl == "debug" {
  "debug"
} else if lvl == "info" {
  "info"
} else if lvl == "warn" {
  "warn"
} else {
  "error"
}

--- Emit `line` plus the attrs object (when non-empty) to console.<m>.
emit := (lvl, line, attrs) ~> do {
  m := console_method(lvl)
  if obj.keys(attrs) == [] {
    call("console", m, [line], ["js_string"], "js_void", false)
  } else {
    call("console", m, [line, attrs], ["js_string", "js_object"], "js_void", false)
  }
  null
}

-- ---------------------------------------------------------------------------
-- Contract surface — emission (effectful)
-- ---------------------------------------------------------------------------

--- log(l, lvl, msg, attrs): `console.<m>("LEVEL ts msg", mergedAttrs)`
--- iff should_log. The text line carries no k=v attrs — the record
--- itself is the second console argument (structured, inspectable).
log := (l, lvl, msg, attrs) ~> do {
  need_level(lvl)
  if should_log(l, lvl) {
    a := merge(l.attrs, attrs)
    emit(lvl, format(iso_now(), lvl, msg, null), a)
  } else {
    null
  }
}

export log := log

--- Per-level conveniences — `log` with the level fixed.
export trace := (l, msg, attrs) ~> log(l, "trace", msg, attrs)
export debug := (l, msg, attrs) ~> log(l, "debug", msg, attrs)
export info  := (l, msg, attrs) ~> log(l, "info",  msg, attrs)
export warn  := (l, msg, attrs) ~> log(l, "warn",  msg, attrs)
export error := (l, msg, attrs) ~> log(l, "error", msg, attrs)
export fatal := (l, msg, attrs) ~> log(l, "fatal", msg, attrs)

--- flush(l): console.* writes synchronously — contract no-op.
export flush := (l) ~> null
