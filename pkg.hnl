-- lib-log-js: modules this package provides (entry defaults to
-- src/index.hnl; N modules resolve to src/<name>/index.hnl).
{
  -- `js` is intentionally NOT a dep: it is a host/builtin contract
  -- (compile-js binds `from "js"` to __handl_rt shims regardless of dep
  -- tables); declaring it resolves `js` to lib-js's signature-erased
  -- exports instead of the ambient `js.*` call_host surface. See AGENTS.md.
  deps: { log: "branch:main" },
  modules: ["log-js"],
  name: "log-js",
  description: "JavaScript backend of the log contract — leveled records to console.* via the js ffi.",
  license: "MIT",
  keywords: ["log", "logging", "console", "js", "backend"],
  homepage: "https://github.com/handl-lang/lib-log-js",
}
